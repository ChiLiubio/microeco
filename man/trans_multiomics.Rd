\describe{
\item{\code{design}}{default NULL; a user-specified design matrix. If NULL, a matrix filled with
\code{weight} (with 0 on the diagonal) is created.}

\item{\code{weight}}{default 0.1; the off-diagonal weight when \code{design} is NULL.}
}
\if{html}{\out{</div>}}
}
